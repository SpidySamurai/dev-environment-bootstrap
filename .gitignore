# Local editor, CodeGraph, and test artefacts
*.swp
*.tmp
/.codegraph/
/test-results/
# Local Pi runtime state
.atl/

# --- Credential guard -------------------------------------------------------
# config/ ships agent configuration, never agent credentials. These patterns
# are a safety net for future re-syncs of the config tree: if any of these ever
# appear, they must not be committed to a public repository.
**/.credentials.json
**/credentials.json
**/auth.json
**/hosts.yml
**/.env
**/.env.*
**/*.pem
**/*.key
**/id_rsa*
**/id_ed25519*
# Agent runtime state and history, not configuration.
**/history.jsonl
**/*.bak
**/*.bak.*
config/agents/*/sessions/
config/agents/*/projects/
config/agents/*/cache/

# Internal working notes: they reference the author's absolute paths and would
# ship to every user's checkout. Kept local, never published.
/odd/
