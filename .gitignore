# Local editor, CodeGraph, and test artefacts
*.swp
*.tmp
/.codegraph/
/test-results/
# Local Pi runtime state
.atl/

# --- Credential guard -------------------------------------------------------
# config/ ships dotfiles, never credentials. These patterns are a
# safety net for future re-syncs of the config tree: if any of these ever
# appear, they must not be committed to a public repository.
**/.credentials.json
**/credentials.json
**/auth.json
**/hosts.yml
**/.env
**/.env.*
**/*.pem
**/*.key
**/id_rsa*
**/id_ed25519*
# Agent runtime state and history, not configuration.
**/history.jsonl
**/*.bak
**/*.bak.*

# Internal working notes: they reference the author's absolute paths and would
# ship to every user's checkout. Kept local, never published.
/odd/

# --- Agent configuration guard ---------------------------------------------
# Coding agents are configured by gentle-ai on each machine. No agent
# configuration or agent instructions are committed here, at any level.
/config/agents/
.claude/
.codex/
.cursor/
**/.github/copilot-instructions.md
CLAUDE.md
AGENTS.md
